<% content_for :title, "Set your password" %>

<%= render "shared/card", { title: "Set your password" } do %>
  <%= render "shared/form_errors", model: @user %>

  <%= form_with url: account_setup_path(params[:token]), method: :patch, class: "flex flex-col gap-4" do |f| %>
    <fieldset class="fieldset py-0">
      <%= f.label :password, "Password", class: "label" %>
      <%= f.password_field :password, required: true, autofocus: true, autocomplete: "new-password", class: "w-full input" %>
    </fieldset>

    <fieldset class="fieldset py-0">
      <%= f.label :password_confirmation, "Confirm password", class: "label" %>
      <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "w-full input" %>
    </fieldset>

    <%= f.submit "Set password", class: "btn btn-primary w-full" %>
  <% end %>
<% end %>
