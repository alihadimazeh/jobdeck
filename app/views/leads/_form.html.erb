<%= form_with model: lead do |form| %>
  <% if lead.errors.any? %>
    <div class="mb-6 p-4 bg-red-50 rounded-md">
      <p class="text-sm font-medium text-red-700 mb-1"><%= pluralize(lead.errors.count, "error") %> prevented this lead from being saved:</p>
      <ul class="list-disc list-inside text-sm text-red-600 space-y-0.5">
        <% lead.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <fieldset class="mb-6">
    <legend class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-3">Lead Details</legend>
    <div class="space-y-4">
      <div>
        <%= form.label :title, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_field :title, class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500" %>
      </div>
      <div>
        <%= form.label :customer_id, "Customer", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.collection_select :customer_id, Customer.order(:last_name, :first_name), :id, :full_name, { prompt: "Select a customer" }, class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500" %>
      </div>
      <div>
        <%= form.label :status, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.select :status, Lead.statuses.keys.map { |k| [k.titleize, k] }, {}, class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500" %>
      </div>
    </div>
  </fieldset>

  <fieldset class="mb-6">
    <legend class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-3">Job Info</legend>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= form.label :job_type, "Job Type", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.select :job_type, Lead.job_types.keys.map { |k| [k.titleize, k] }, { include_blank: "None" }, class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500" %>
      </div>
      <div>
        <%= form.label :source, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.select :source, Lead.sources.keys.map { |k| [k.titleize, k] }, { include_blank: "None" }, class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500" %>
      </div>
      <div>
        <%= form.label :estimated_value, "Estimated Value ($)", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.number_field :estimated_value, step: "0.01", min: 0, class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500" %>
      </div>
      <div>
        <%= form.label :assigned_to, "Assigned To", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_field :assigned_to, class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500" %>
      </div>
    </div>
  </fieldset>

  <fieldset class="mb-6">
    <legend class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-3">Follow-up & Notes</legend>
    <div class="space-y-4">
      <div>
        <%= form.label :follow_up_date, "Follow-up Date", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.date_field :follow_up_date, class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500" %>
      </div>
      <div>
        <%= form.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_area :description, rows: 4, class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500" %>
      </div>
    </div>
  </fieldset>

  <%= form.submit class: "rounded-md px-4 py-2.5 bg-amber-600 hover:bg-amber-500 text-white text-sm font-medium cursor-pointer" %>
<% end %>
