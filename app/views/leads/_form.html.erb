<%= form_with model: lead do |form| %>
  <%= render partial: "shared/form_errors", locals: { model: lead } %>

  <fieldset class="mb-6">
    <legend class="text-sm font-semibold text-base-content uppercase tracking-wide mb-3">Lead Details</legend>
    <div class="space-y-4">
      <%= render partial: "shared/field", locals: { form: form, attr: :title } %>
      <%= render partial: "shared/field", locals: {
            form: form, attr: :customer_id, label: "Customer", as: :select,
            collection: Customer.order(:last_name, :first_name).map { |c| [ c.full_name, c.id ] },
            select_options: { include_blank: "Select a customer" }
          } %>
      <%= render partial: "shared/field", locals: {
            form: form, attr: :status, as: :select,
            collection: Lead.statuses.keys.map { |k| [ k.titleize, k ] }
          } %>
    </div>
  </fieldset>

  <fieldset class="mb-6">
    <legend class="text-sm font-semibold text-base-content uppercase tracking-wide mb-3">Job Info</legend>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <%= render partial: "shared/field", locals: {
            form: form, attr: :job_type, label: "Job Type", as: :select,
            collection: Lead.job_types.keys.map { |k| [ k.titleize, k ] },
            select_options: { include_blank: "None" }
          } %>
      <%= render partial: "shared/field", locals: {
            form: form, attr: :source, as: :select,
            collection: Lead.sources.keys.map { |k| [ k.titleize, k ] },
            select_options: { include_blank: "None" }
          } %>
      <%= render partial: "shared/field", locals: {
            form: form, attr: :estimated_value, label: "Estimated Value ($)", as: :number,
            options: { step: "0.01", min: 0 }
          } %>
      <%= render partial: "shared/field", locals: { form: form, attr: :assigned_to, label: "Assigned To" } %>
    </div>
  </fieldset>

  <fieldset class="mb-6">
    <legend class="text-sm font-semibold text-base-content uppercase tracking-wide mb-3">Follow-up & Notes</legend>
    <div class="space-y-4">
      <%= render partial: "shared/field", locals: { form: form, attr: :follow_up_date, label: "Follow-up Date", as: :date } %>
      <%= render partial: "shared/field", locals: { form: form, attr: :description, as: :textarea } %>
    </div>
  </fieldset>

  <%= form.submit class: "btn btn-primary", data: { turbo_submits_with: "Saving…" } %>
<% end %>
