<% content_for :title, "Leads" %>

<%= render partial: "shared/page_header", locals: {
      title: "Leads",
      action: (policy(Lead).create? ? { label: "New Lead", path: new_lead_path } : nil)
    } %>

<%# The dashboard's "View all" links arrive with a follow-up filter the search form below has no
    field for - say so, or the list silently looks like it's missing leads. %>
<% follow_up_filter = if params.dig(:q, :follow_up_date_eq).present? then "due today"
                      elsif params.dig(:q, :follow_up_date_lt).present? then "overdue"
                      end %>
<% if follow_up_filter %>
  <p class="mb-4 text-sm text-base-content/70">
    Showing open leads with a follow-up <%= follow_up_filter %>.
    <%= link_to "Show all leads", leads_path, class: "link link-primary" %>
  </p>
<% end %>

<%= search_form_for @q, url: leads_path, class: "mb-4 flex gap-2 max-w-lg" do |f| %>
  <%= f.label :title_or_customer_first_name_or_customer_last_name_cont, "Search leads", class: "sr-only" %>
  <%= f.search_field :title_or_customer_first_name_or_customer_last_name_cont,
        class: "input input-sm w-full", placeholder: "Search leads…" %>
  <%# Ransack's *_eq predicate on an enum column needs the underlying integer, not the
      label - it doesn't know about Rails enums and naively casts a non-numeric string
      like "contacted" via #to_i, which silently resolves to 0 ("new") instead of
      raising. Lead.statuses is {"new"=>0, "contacted"=>1, ...} - use the values. %>
  <%= f.label :status_eq, "Filter by status", class: "sr-only" %>
  <%= f.select :status_eq, Lead.statuses.map { |key, value| [ key.titleize, value ] },
        { include_blank: "Any status" }, class: "select select-sm" %>
  <%= f.submit "Search", class: "btn btn-sm" %>
  <%# Carry the dashboard's filter through a search. These have no visible control here, so
      without them a search on "Overdue" silently widened to every lead, converted and lost
      included, and the note above vanished. "Show all leads" is the way out. %>
  <% %w[follow_up_date_eq follow_up_date_lt].each do |key| %>
    <% if (value = params.dig(:q, key)).present? %>
      <%= hidden_field_tag "q[#{key}]", value, id: nil %>
    <% end %>
  <% end %>
  <% %w[status_not_in s].each do |key| %>
    <% Array(params.dig(:q, key)).each do |value| %>
      <%= hidden_field_tag "q[#{key}][]", value, id: nil %>
    <% end %>
  <% end %>
<% end %>

<%= render "shared/table", { columns: [ "Title", "Customer", "Status", "Follow-up", "" ] } do %>
  <% if @leads.any? %>
    <%= render @leads %>
  <% elsif @q.conditions.any? %>
    <%= render partial: "shared/empty_state", locals: {
          title: "No leads match your search.", colspan: 5,
          cta: { label: "Clear search", path: leads_path }
        } %>
  <% else %>
    <%= render partial: "shared/empty_state", locals: {
          title: "No leads yet.", colspan: 5,
          cta: (policy(Lead).create? ? { label: "Add the first one", path: new_lead_path } : nil)
        } %>
  <% end %>
<% end %>

<%== @pagy.series_nav if @pagy.pages > 1 %>
