<% content_for :title, "Leads" %>

<%= render partial: "shared/page_header", locals: {
      title: "Leads",
      action: { label: "New Lead", path: new_lead_path }
    } %>

<%= render "shared/table", { columns: [ "Title", "Customer", "Status", "Follow-up", "" ] } do %>
  <% if @leads.any? %>
    <%= render @leads %>
  <% else %>
    <%= render partial: "shared/empty_state", locals: {
          title: "No leads yet.", colspan: 5,
          cta: { label: "Add the first one", path: new_lead_path }
        } %>
  <% end %>
<% end %>
