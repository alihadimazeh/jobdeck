<% content_for :title, @lead.title %>
<% content_for :breadcrumbs do %>
  <%= link_to "Leads", leads_path %> &rsaquo; <%= @lead.title %>
<% end %>
<% content_for :page_heading, @lead.title %>

<%# Lead details %>
<div class="bg-white rounded-lg border border-gray-200 p-6 mb-6">
  <div class="flex justify-between items-start">
    <div class="grid grid-cols-2 gap-x-12 gap-y-4 flex-1">
      <div>
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Customer</p>
        <p class="text-sm text-gray-900"><%= link_to @lead.customer.full_name, @lead.customer, class: "hover:text-amber-600" %></p>
      </div>
      <div>
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Status</p>
        <% badge_classes = { "new" => "bg-gray-100 text-gray-600", "contacted" => "bg-blue-100 text-blue-700", "quoted" => "bg-amber-100 text-amber-700", "converted" => "bg-green-100 text-green-700", "lost" => "bg-red-100 text-red-600" } %>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-semibold uppercase tracking-wide <%= badge_classes[@lead.status] || "bg-gray-100 text-gray-600" %>">
          <%= @lead.status %>
        </span>
      </div>
      <div>
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Job Type</p>
        <p class="text-sm text-gray-900"><%= @lead.job_type&.titleize || "—" %></p>
      </div>
      <div>
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Source</p>
        <p class="text-sm text-gray-900"><%= @lead.source&.titleize || "—" %></p>
      </div>
      <div>
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Estimated Value</p>
        <p class="text-sm text-gray-900"><%= @lead.estimated_value ? number_to_currency(@lead.estimated_value) : "—" %></p>
      </div>
      <div>
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Assigned To</p>
        <p class="text-sm text-gray-900"><%= @lead.assigned_to.presence || "—" %></p>
      </div>
      <div>
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Follow-up Date</p>
        <p class="text-sm text-gray-900"><%= @lead.follow_up_date&.strftime("%b %d, %Y") || "—" %></p>
      </div>
      <% if @lead.description.present? %>
        <div class="col-span-2">
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Description</p>
          <p class="text-sm text-gray-900"><%= @lead.description %></p>
        </div>
      <% end %>
    </div>
    <%= link_to "Edit", edit_lead_path(@lead), class: "text-sm font-medium text-gray-500 hover:text-gray-700 ml-6" %>
  </div>
</div>

<%# Related job %>
<% if @lead.job.present? %>
  <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
    <div class="flex justify-between items-center px-6 py-4 border-b border-gray-200">
      <h2 class="text-sm font-semibold text-gray-700">Job</h2>
    </div>
    <table class="min-w-full divide-y divide-gray-100">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Title</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Status</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Start Date</th>
        </tr>
      </thead>
      <tbody>
        <tr class="hover:bg-gray-50">
          <td class="px-6 py-4 text-sm font-medium text-gray-900">
            <%= link_to @lead.job.title, @lead.job, class: "hover:text-amber-600" %>
          </td>
          <td class="px-6 py-4">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-semibold uppercase tracking-wide bg-gray-100 text-gray-600">
              <%= @lead.job.status %>
            </span>
          </td>
          <td class="px-6 py-4 text-sm text-gray-500">
            <%= @lead.job.start_date&.strftime("%b %d, %Y") || "—" %>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
<% end %>

<%# Quotes %>
<div class="bg-white rounded-lg border border-gray-200 overflow-hidden <%= "mt-6" if @lead.job.present? %>">
  <div class="flex justify-between items-center px-6 py-4 border-b border-gray-200">
    <h2 class="text-sm font-semibold text-gray-700">Quotes</h2>
    <%= link_to "Create Quote", new_lead_quote_path(@lead), class: "text-sm font-medium text-amber-600 hover:text-amber-500" %>
  </div>
  <% if @lead.quotes.any? %>
    <table class="min-w-full divide-y divide-gray-100">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Quote #</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Status</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Total</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @lead.quotes.order(created_at: :desc).each do |quote| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 text-sm font-medium text-gray-900">
              <%= link_to quote.quote_number, quote, class: "hover:text-amber-600" %>
            </td>
            <td class="px-6 py-4">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-semibold uppercase tracking-wide <%= quote_status_badge_classes(quote.status) %>">
                <%= quote.status %>
              </span>
            </td>
            <td class="px-6 py-4 text-sm text-gray-500">
              <%= number_to_currency(quote.total) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="px-6 py-8 text-sm text-gray-400 text-center">No quotes yet.</p>
  <% end %>
</div>
