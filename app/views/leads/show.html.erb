<% content_for :title, @lead.title %>

<% actions = capture do %>
  <%= link_to "Edit", edit_lead_path(@lead), class: "btn btn-ghost btn-sm" %>
<% end %>

<%= render partial: "shared/page_header", locals: {
      title: @lead.title,
      breadcrumbs: [ [ "Leads", leads_path ] ],
      actions: actions
    } %>

<%# Lead details %>
<div class="mb-6">
  <%= render "shared/card" do %>
    <%= render partial: "shared/detail_list", locals: { items: [
          [ "Customer", link_to(@lead.customer.full_name, @lead.customer, class: "hover:text-primary") ],
          [ "Status", status_badge(@lead) ],
          [ "Job Type", @lead.job_type&.titleize ],
          [ "Source", @lead.source&.titleize ],
          [ "Estimated Value", format_currency(@lead.estimated_value) ],
          [ "Assigned To", @lead.assigned_to ],
          [ "Follow-up Date", format_date(@lead.follow_up_date) ]
        ] } %>
    <% if @lead.description.present? %>
      <div class="mt-4 pt-4 border-t border-base-300">
        <p class="text-xs font-semibold uppercase tracking-wide text-base-content/70 mb-1">Description</p>
        <p class="text-sm text-base-content"><%= @lead.description %></p>
      </div>
    <% end %>
  <% end %>
</div>

<%# Related job %>
<% if @lead.job.present? %>
  <div class="mb-6">
    <%= render "shared/card", { title: "Job", padded: false } do %>
      <%= render "shared/table", { columns: [ "Title", "Status", "Start Date" ] } do %>
        <%= render "jobs/job", job: @lead.job, show_customer: false, show_actions: false %>
      <% end %>
    <% end %>
  </div>
<% end %>

<%# Quotes %>
<% quote_actions = capture do %>
  <%= link_to "Create Quote", new_lead_quote_path(@lead), class: "btn btn-ghost btn-sm text-primary" %>
<% end %>

<%= render "shared/card", { title: "Quotes", actions: quote_actions, padded: false } do %>
  <%= render "shared/table", { columns: [ "Quote #", "Status", "Total" ] } do %>
    <% if @lead.quotes.any? %>
      <% @lead.quotes.order(created_at: :desc).each do |quote| %>
        <tr class="hover">
          <td class="font-medium text-base-content">
            <%= link_to quote.quote_number, quote, class: "hover:text-primary" %>
          </td>
          <td><%= status_badge(quote) %></td>
          <td class="text-base-content/70"><%= format_currency(quote.total) %></td>
        </tr>
      <% end %>
    <% else %>
      <%= render partial: "shared/empty_state", locals: { title: "No quotes yet.", colspan: 3 } %>
    <% end %>
  <% end %>
<% end %>

<%# Activity notes %>
<div class="mt-6">
  <%= render "activity_notes/section", notable: @lead, activity_note: @activity_note %>
</div>

<%# Documents %>
<div class="mt-6">
  <%= render "documents/section", documentable: @lead, document: @document %>
</div>
