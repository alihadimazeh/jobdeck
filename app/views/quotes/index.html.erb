<% content_for :title, "Quotes for #{@lead.title}" %>

<%= render partial: "shared/page_header", locals: {
      title: "Quotes for #{@lead.title}",
      breadcrumbs: [ [ "Leads", leads_path ], [ @lead.title, lead_path(@lead) ] ],
      action: { label: "New Quote", path: new_lead_quote_path(@lead) }
    } %>

<%= render "shared/table", { columns: [ "Quote #", "Status", "Issued", "Total", "" ] } do %>
  <% if @quotes.any? %>
    <%= render @quotes %>
  <% else %>
    <%= render partial: "shared/empty_state", locals: {
          title: "No quotes yet.", colspan: 5,
          cta: { label: "Add the first one", path: new_lead_quote_path(@lead) }
        } %>
  <% end %>
<% end %>
