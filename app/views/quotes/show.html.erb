<% content_for :title, @quote.quote_number %>
<% content_for :breadcrumbs do %>
  <%= link_to "Leads", leads_path %> &rsaquo; <%= link_to @quote.lead.title, @quote.lead %> &rsaquo; <%= @quote.quote_number %>
<% end %>
<% content_for :page_heading, @quote.quote_number %>

<%# Quote details %>
<div class="bg-white rounded-lg border border-gray-200 p-6 mb-6">
  <div class="flex justify-between items-start">
    <div class="grid grid-cols-2 gap-x-12 gap-y-4 flex-1">
      <div>
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Customer</p>
        <p class="text-sm text-gray-900"><%= link_to @quote.customer.full_name, @quote.customer, class: "hover:text-amber-600" %></p>
      </div>
      <div>
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Status</p>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-semibold uppercase tracking-wide <%= quote_status_badge_classes(@quote.status) %>">
          <%= @quote.status %>
        </span>
      </div>
      <div>
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Issued Date</p>
        <p class="text-sm text-gray-900"><%= @quote.issued_date&.strftime("%b %d, %Y") || "—" %></p>
      </div>
      <div>
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Valid Until</p>
        <p class="text-sm text-gray-900"><%= @quote.valid_until&.strftime("%b %d, %Y") || "—" %></p>
      </div>
      <div>
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Subtotal</p>
        <p class="text-sm text-gray-900"><%= number_to_currency(@quote.subtotal) %></p>
      </div>
      <div>
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Tax Rate</p>
        <p class="text-sm text-gray-900"><%= number_to_percentage(@quote.tax_rate.to_f * 100, precision: 2) %></p>
      </div>
      <div>
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Total</p>
        <p class="text-sm text-gray-900 font-semibold"><%= number_to_currency(@quote.total) %></p>
      </div>
      <% if @quote.notes.present? %>
        <div class="col-span-2">
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Notes</p>
          <p class="text-sm text-gray-900"><%= @quote.notes %></p>
        </div>
      <% end %>
    </div>
    <div class="flex items-center gap-3 ml-6 flex-shrink-0">
      <%= link_to "Edit", edit_quote_path(@quote), class: "text-sm font-medium text-gray-500 hover:text-gray-700" %>
      <%= button_to "Delete", @quote, method: :delete,
            form: { data: { turbo_confirm: "Are you sure you want to delete this quote?" } },
            class: "text-sm font-medium text-red-500 hover:text-red-700 bg-transparent border-0 cursor-pointer p-0" %>
    </div>
  </div>
</div>

<%# Rooms %>
<div class="bg-white rounded-lg border border-gray-200 overflow-hidden mb-6">
  <div class="flex justify-between items-center px-6 py-4 border-b border-gray-200">
    <h2 class="text-sm font-semibold text-gray-700">Rooms</h2>
    <p class="text-sm text-gray-500"><%= number_with_precision(@quote.total_area, precision: 2) %> sqft total</p>
  </div>
  <% if @quote.rooms.any? %>
    <table class="min-w-full divide-y divide-gray-100">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Name</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Length</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Width</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Area</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Notes</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @quote.rooms.each do |room| %>
          <tr>
            <td class="px-6 py-4 text-sm font-medium text-gray-900"><%= room.name %></td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= room.length %></td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= room.width %></td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= room.area %> sqft</td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= room.notes.presence || "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="px-6 py-8 text-sm text-gray-400 text-center">No rooms added yet.</p>
  <% end %>
</div>

<%# Line items %>
<div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
  <div class="px-6 py-4 border-b border-gray-200">
    <h2 class="text-sm font-semibold text-gray-700">Line Items</h2>
  </div>
  <% if @quote.quote_line_items.any? %>
    <table class="min-w-full divide-y divide-gray-100">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Type</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Description</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Qty</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Unit</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Unit Price</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Total</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @quote.quote_line_items.each do |line_item| %>
          <tr>
            <td class="px-6 py-4 text-sm text-gray-500"><%= line_item.item_type.titleize %></td>
            <td class="px-6 py-4 text-sm font-medium text-gray-900"><%= line_item.description %></td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= line_item.quantity %></td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= line_item.unit %></td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= number_to_currency(line_item.unit_price) %></td>
            <td class="px-6 py-4 text-sm text-gray-900 font-medium"><%= number_to_currency(line_item.total) %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr class="bg-gray-50">
          <td colspan="5" class="px-6 py-3 text-sm font-semibold text-gray-700 text-right">Total</td>
          <td class="px-6 py-3 text-sm font-semibold text-gray-900"><%= number_to_currency(@quote.total) %></td>
        </tr>
      </tfoot>
    </table>
  <% else %>
    <p class="px-6 py-8 text-sm text-gray-400 text-center">No line items added yet.</p>
  <% end %>
</div>
