<% content_for :title, @quote.quote_number %>

<% actions = capture do %>
  <% if @quote.draft_status? || @quote.sent_status? %>
    <%= button_to "Accept Quote", accept_quote_path(@quote), method: :patch,
          form: { data: { turbo_confirm: "Accept this quote and create a job?" } },
          class: "btn btn-primary btn-sm" %>
  <% end %>
  <%= link_to "Edit", edit_quote_path(@quote), class: "btn btn-ghost btn-sm" %>
  <%= button_to "Delete", @quote, method: :delete,
        form: { data: { turbo_confirm: "Are you sure you want to delete this quote?" } },
        class: "btn btn-ghost btn-sm text-error" %>
<% end %>

<%= render partial: "shared/page_header", locals: {
      title: @quote.quote_number,
      breadcrumbs: [ [ "Leads", leads_path ], [ @quote.lead.title, lead_path(@quote.lead) ] ],
      actions: actions
    } %>

<%# Quote details %>
<div class="mb-6">
  <%= render "shared/card" do %>
    <%= render partial: "shared/detail_list", locals: { items: [
          [ "Customer", link_to(@quote.customer.full_name, @quote.customer, class: "hover:text-primary") ],
          [ "Status", status_badge(@quote) ],
          [ "Issued Date", format_date(@quote.issued_date) ],
          [ "Valid Until", format_date(@quote.valid_until) ],
          [ "Subtotal", format_currency(@quote.subtotal) ],
          [ "Tax Rate", number_to_percentage(@quote.tax_rate.to_f * 100, precision: 2) ],
          [ "Total", tag.span(format_currency(@quote.total), class: "font-semibold") ]
        ] } %>
    <% if @quote.notes.present? %>
      <div class="mt-4 pt-4 border-t border-base-300">
        <p class="text-xs font-semibold uppercase tracking-wide text-base-content/70 mb-1">Notes</p>
        <p class="text-sm text-base-content"><%= @quote.notes %></p>
      </div>
    <% end %>
  <% end %>
</div>

<%# Rooms %>
<% room_actions = capture do %>
  <p class="text-sm text-base-content/70"><%= number_with_precision(@quote.total_area, precision: 2) %> sqft total</p>
<% end %>

<div class="mb-6">
  <%= render "shared/card", { title: "Rooms", actions: room_actions, padded: false } do %>
    <%= render "shared/table", { columns: [ "Name", "Length", "Width", "Area", "Notes" ] } do %>
      <% if @quote.rooms.any? %>
        <% @quote.rooms.each do |room| %>
          <tr>
            <td class="font-medium text-base-content"><%= room.name %></td>
            <td class="text-base-content/70"><%= room.length %></td>
            <td class="text-base-content/70"><%= room.width %></td>
            <td class="text-base-content/70"><%= room.area %> sqft</td>
            <td class="text-base-content/70"><%= room.notes.presence || "—" %></td>
          </tr>
        <% end %>
      <% else %>
        <%= render partial: "shared/empty_state", locals: { title: "No rooms added yet.", colspan: 5 } %>
      <% end %>
    <% end %>
  <% end %>
</div>

<%# Line items %>
<% line_items_footer = capture do %>
  <tr class="bg-base-200">
    <td colspan="5" class="text-right font-semibold text-base-content">Total</td>
    <td class="font-semibold text-base-content"><%= format_currency(@quote.total) %></td>
  </tr>
<% end if @quote.quote_line_items.any? %>

<%= render "shared/card", { title: "Line Items", padded: false } do %>
  <%= render "shared/table", {
        columns: [ "Type", "Description", "Qty", "Unit", "Unit Price", "Total" ],
        footer: line_items_footer
      } do %>
    <% if @quote.quote_line_items.any? %>
      <% @quote.quote_line_items.each do |line_item| %>
        <tr>
          <td class="text-base-content/70"><%= line_item.item_type.titleize %></td>
          <td class="font-medium text-base-content"><%= line_item.description %></td>
          <td class="text-base-content/70"><%= line_item.quantity %></td>
          <td class="text-base-content/70"><%= line_item.unit %></td>
          <td class="text-base-content/70"><%= format_currency(line_item.unit_price) %></td>
          <td class="font-medium text-base-content"><%= format_currency(line_item.total) %></td>
        </tr>
      <% end %>
    <% else %>
      <%= render partial: "shared/empty_state", locals: { title: "No line items added yet.", colspan: 6 } %>
    <% end %>
  <% end %>
<% end %>
