<tr id="<%= dom_id(quote) %>" class="hover">
  <td class="font-medium text-base-content">
    <%= link_to quote.quote_number, quote, class: "hover:text-primary" %>
  </td>
  <td><%= status_badge(quote) %></td>
  <td class="text-base-content/70"><%= format_date(quote.issued_date) %></td>
  <td class="font-medium text-base-content"><%= format_currency(quote.total) %></td>
  <td>
    <%= render partial: "shared/row_actions", locals: {
          edit_path: edit_quote_path(quote),
          delete_path: quote_path(quote),
          delete_confirm: "Are you sure you want to delete this quote?",
          label: quote.quote_number,
          id: dom_id(quote)
        } %>
  </td>
</tr>
