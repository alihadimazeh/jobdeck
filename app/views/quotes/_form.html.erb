<%= form_with model: quote,
      url: (quote.persisted? ? quote_path(quote) : lead_quotes_path(quote.lead)),
      html: { data: { controller: "quote-form" } } do |form| %>
  <p class="sr-only" aria-live="polite" data-quote-form-target="status"></p>

  <%= render partial: "shared/form_errors", locals: { model: quote } %>

  <fieldset class="mb-6">
    <legend class="text-sm font-semibold text-base-content uppercase tracking-wide mb-3">Quote Details</legend>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <%= render partial: "shared/field", locals: {
            form: form, attr: :status, as: :select,
            collection: Quote.statuses.keys.map { |k| [ k.titleize, k ] }
          } %>
      <%= render partial: "shared/field", locals: {
            form: form, attr: :tax_rate, label: "Tax Rate", as: :number,
            options: { step: "0.0001", min: 0 }, hint: "Decimal, e.g. 0.13 for 13%"
          } %>
      <%= render partial: "shared/field", locals: { form: form, attr: :issued_date, label: "Issued Date", as: :date } %>
      <%= render partial: "shared/field", locals: { form: form, attr: :valid_until, label: "Valid Until", as: :date } %>
      <div class="sm:col-span-2">
        <%= render partial: "shared/field", locals: { form: form, attr: :notes, as: :textarea } %>
      </div>
    </div>
  </fieldset>

  <fieldset class="mb-6">
    <legend class="text-sm font-semibold text-base-content uppercase tracking-wide mb-3">Rooms</legend>

    <div class="hidden sm:grid grid-cols-12 gap-3 px-0 pb-1 text-xs font-semibold text-base-content/70 uppercase tracking-wide">
      <div class="col-span-3">Name</div>
      <div class="col-span-2">Length</div>
      <div class="col-span-2">Width</div>
      <div class="col-span-2">Area</div>
      <div class="col-span-2">Notes</div>
      <div class="col-span-1"></div>
    </div>

    <div data-quote-form-target="roomsContainer">
      <%= form.fields_for :rooms do |room_form| %>
        <%= render "room_fields", form: room_form %>
      <% end %>
    </div>

    <template data-quote-form-target="roomTemplate">
      <%= form.fields_for :rooms, Room.new, child_index: "NEW_RECORD" do |room_form| %>
        <%= render "room_fields", form: room_form %>
      <% end %>
    </template>

    <div class="flex flex-wrap justify-between items-center gap-2 mt-3">
      <button type="button" data-action="click->quote-form#addRoom" data-quote-form-target="addRoomButton"
              class="btn btn-ghost btn-sm text-primary">
        + Add Room
      </button>
      <p class="text-sm text-base-content/70">
        Total area: <span data-quote-form-target="totalArea"><%= quote.total_area %></span> sqft
      </p>
    </div>
  </fieldset>

  <fieldset class="mb-6">
    <legend class="text-sm font-semibold text-base-content uppercase tracking-wide mb-3">Estimation Tool</legend>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3 sm:items-end">
      <div>
        <label class="label" for="quote_labor_rate">Labor Rate ($/sqft)</label>
        <input type="number" step="0.01" min="0" id="quote_labor_rate" data-quote-form-target="laborRate" class="input w-full">
      </div>
      <div>
        <label class="label" for="quote_material_rate">Material Rate ($/sqft)</label>
        <input type="number" step="0.01" min="0" id="quote_material_rate" data-quote-form-target="materialRate" class="input w-full">
      </div>
      <div>
        <button type="button" data-action="click->quote-form#populateLineItems"
                class="btn btn-secondary w-full">
          Populate Line Items
        </button>
      </div>
    </div>
    <p class="text-xs text-base-content/70 mt-2">Uses total room area × each rate to replace the line items below with fresh labor/material rows.</p>
  </fieldset>

  <fieldset class="mb-6">
    <legend class="text-sm font-semibold text-base-content uppercase tracking-wide mb-3">Line Items</legend>

    <div class="hidden sm:grid grid-cols-12 gap-3 px-0 pb-1 text-xs font-semibold text-base-content/70 uppercase tracking-wide">
      <div class="col-span-2">Type</div>
      <div class="col-span-4">Description</div>
      <div class="col-span-1">Qty</div>
      <div class="col-span-1">Unit</div>
      <div class="col-span-2">Unit Price</div>
      <div class="col-span-1">Total</div>
      <div class="col-span-1"></div>
    </div>

    <div data-quote-form-target="lineItemsContainer">
      <%= form.fields_for :quote_line_items do |line_item_form| %>
        <%= render "quote_line_item_fields", form: line_item_form %>
      <% end %>
    </div>

    <template data-quote-form-target="lineItemTemplate">
      <%= form.fields_for :quote_line_items, QuoteLineItem.new, child_index: "NEW_RECORD" do |line_item_form| %>
        <%= render "quote_line_item_fields", form: line_item_form %>
      <% end %>
    </template>

    <button type="button" data-action="click->quote-form#addLineItem" data-quote-form-target="addLineItemButton"
            class="btn btn-ghost btn-sm text-primary mt-3">
      + Add Line Item
    </button>
  </fieldset>

  <%= form.submit class: "btn btn-primary", data: { turbo_submits_with: "Saving…" } %>
<% end %>
