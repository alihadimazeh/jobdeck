<%#
  R4 responsive rework - see quote_form_controller.js for the invariants this preserves:
  data-quote-form-target="roomRow" on the row root (kept, with a grid/sm:grid class that
  "hidden" can still override for soft-delete); [data-room-length]/[data-room-width]/
  [data-room-destroy] on the same inputs; [data-room-area] stays a bare span (only the
  number/em-dash inside it - the "Area" label below is a sibling, not a parent).
%>
<div data-quote-form-target="roomRow"
     class="grid grid-cols-1 gap-2 py-3 border-b border-base-300 last:border-0 sm:grid-cols-12 sm:gap-3 sm:items-center sm:py-2">
  <div class="sm:col-span-3">
    <span class="sm:hidden text-xs font-medium text-base-content/70">Room name</span>
    <%= form.text_field :name, placeholder: "Room name", "aria-label": "Room name",
          class: "input input-sm w-full" %>
  </div>
  <div class="sm:col-span-2">
    <span class="sm:hidden text-xs font-medium text-base-content/70">Length</span>
    <%= form.number_field :length, step: "0.01", min: 0, placeholder: "Length", "aria-label": "Length",
          data: { room_length: true, action: "input->quote-form#updateRoomArea" },
          class: "input input-sm w-full" %>
  </div>
  <div class="sm:col-span-2">
    <span class="sm:hidden text-xs font-medium text-base-content/70">Width</span>
    <%= form.number_field :width, step: "0.01", min: 0, placeholder: "Width", "aria-label": "Width",
          data: { room_width: true, action: "input->quote-form#updateRoomArea" },
          class: "input input-sm w-full" %>
  </div>
  <div class="sm:col-span-2 text-sm text-base-content/70">
    <span class="sm:hidden">Area </span><span data-room-area><%= form.object.area || "—" %></span> sqft
  </div>
  <div class="sm:col-span-2">
    <span class="sm:hidden text-xs font-medium text-base-content/70">Notes</span>
    <%= form.text_field :notes, placeholder: "Notes", "aria-label": "Room notes",
          class: "input input-sm w-full" %>
  </div>
  <div class="flex justify-end sm:col-span-1 sm:block sm:text-right">
    <%= form.hidden_field :_destroy, data: { room_destroy: true } %>
    <button type="button" data-action="click->quote-form#removeRoom"
            class="btn btn-ghost btn-sm btn-square text-base-content/50 hover:text-error"
            aria-label="Remove room">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
</div>
