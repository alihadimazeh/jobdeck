<% content_for :title, "Edit #{@quote.quote_number}" %>

<%= render partial: "shared/page_header", locals: {
      title: "Edit #{@quote.quote_number}",
      breadcrumbs: [
        [ "Leads", leads_path ],
        [ @quote.lead.title, lead_path(@quote.lead) ],
        [ @quote.quote_number, quote_path(@quote) ]
      ]
    } %>

<%= render "shared/form_container", { width: :lg } do %>
  <%= render "form", quote: @quote %>
<% end %>
