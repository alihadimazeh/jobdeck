<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "Jobdeck" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Jobdeck">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full bg-[#F9F8F6] text-gray-900 antialiased">
    <div class="flex h-full">

      <%# Sidebar %>
      <aside class="w-56 bg-[#1E2228] flex flex-col flex-shrink-0">

        <%# Brand %>
        <div class="px-5 py-6 flex items-center gap-3">
          <div class="grid grid-cols-2 gap-0.5">
            <div class="w-2.5 h-2.5 bg-amber-500 rounded-sm"></div>
            <div class="w-2.5 h-2.5 bg-amber-500/50 rounded-sm"></div>
            <div class="w-2.5 h-2.5 bg-amber-500/50 rounded-sm"></div>
            <div class="w-2.5 h-2.5 bg-amber-500 rounded-sm"></div>
          </div>
          <span class="text-white font-semibold tracking-wide text-sm">Jobdeck</span>
        </div>

        <%# Nav links %>
        <nav class="flex-1 px-3 pb-6 space-y-0.5">
          <%= nav_link "Customers", customers_path, controller_name == "customers" %>
          <%= nav_link "Leads", leads_path, controller_name == "leads" %>
          <%= nav_link "Jobs", jobs_path, controller_name == "jobs" %>
        </nav>

      </aside>

      <%# Main area %>
      <div class="flex-1 flex flex-col min-w-0">

        <%# Top bar %>
        <header class="bg-white border-b border-gray-200 px-8 py-4">
          <% if content_for?(:breadcrumbs) %>
            <nav class="text-xs text-gray-400 mb-1 font-medium tracking-wide uppercase">
              <%= yield :breadcrumbs %>
            </nav>
          <% end %>
          <% if content_for?(:page_heading) %>
            <h1 class="text-xl font-semibold text-gray-900"><%= yield :page_heading %></h1>
          <% end %>
        </header>

        <%# Page content %>
        <main class="flex-1 overflow-auto p-8">
          <% if notice.present? %>
            <p class="mb-5 px-4 py-2.5 bg-green-50 text-green-700 text-sm font-medium rounded-md inline-block"><%= notice %></p>
          <% end %>
          <% if alert.present? %>
            <p class="mb-5 px-4 py-2.5 bg-red-50 text-red-700 text-sm font-medium rounded-md inline-block"><%= alert %></p>
          <% end %>
          <%= yield %>
        </main>

      </div>

    </div>
  </body>
</html>
