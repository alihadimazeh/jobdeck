<!DOCTYPE html>
<html lang="en" data-theme="jobdeck" class="h-full">
  <head>
    <title><%= content_for(:title) || "Jobdeck" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Jobdeck">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= preload_link_tag asset_path("inter/InterVariable.woff2"), as: "font", type: "font/woff2", crossorigin: "anonymous" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full bg-base-200 text-base-content antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:btn focus:btn-primary">
      Skip to content
    </a>

    <div class="drawer lg:drawer-open h-full">
      <input id="app-drawer" type="checkbox" class="drawer-toggle">

      <%# Drawer content: navbar (mobile only) + header + page body %>
      <div class="drawer-content flex flex-col h-full min-w-0">
        <%= render "layouts/navbar" %>

        <header class="bg-base-100 border-b border-base-300 px-4 sm:px-8 py-4">
          <% if content_for?(:breadcrumbs) %>
            <nav aria-label="Breadcrumb" class="text-xs text-base-content/70 mb-1 font-medium tracking-wide uppercase">
              <%= yield :breadcrumbs %>
            </nav>
          <% end %>
          <% if content_for?(:page_heading) %>
            <h1 class="text-xl font-semibold text-base-content"><%= yield :page_heading %></h1>
          <% end %>
        </header>

        <main id="main" tabindex="-1" class="flex-1 overflow-auto p-4 sm:p-8">
          <%= render "shared/flash" %>
          <%= yield %>
        </main>
      </div>

      <%# Drawer side: permanently visible rail >=lg, toggleable overlay below it %>
      <div class="drawer-side z-40">
        <label for="app-drawer" aria-label="Close navigation" class="drawer-overlay"></label>
        <%= render "layouts/sidebar" %>
      </div>
    </div>
  </body>
</html>
