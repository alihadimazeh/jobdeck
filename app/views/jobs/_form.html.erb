<%= form_with model: job do |form| %>
  <%= render partial: "shared/form_errors", locals: { model: job } %>

  <fieldset class="mb-6">
    <legend class="text-sm font-semibold text-base-content uppercase tracking-wide mb-3">Job Details</legend>
    <div class="space-y-4">
      <%= render partial: "shared/field", locals: { form: form, attr: :title } %>
      <%= render partial: "shared/field", locals: {
            form: form, attr: :customer_id, label: "Customer", as: :select,
            collection: Customer.order(:last_name, :first_name).map { |c| [ c.full_name, c.id ] },
            select_options: { include_blank: "Select a customer" }
          } %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <%= render partial: "shared/field", locals: {
              form: form, attr: :status, as: :select,
              collection: Job.statuses.keys.map { |k| [ k.humanize, k ] }
            } %>
        <%= render partial: "shared/field", locals: {
              form: form, attr: :job_type, label: "Job Type", as: :select,
              collection: Job.job_types.keys.map { |k| [ k.titleize, k ] },
              select_options: { include_blank: "None" }
            } %>
      </div>
    </div>
  </fieldset>

  <fieldset class="mb-6">
    <legend class="text-sm font-semibold text-base-content uppercase tracking-wide mb-3">Schedule &amp; Assignment</legend>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <%= render partial: "shared/field", locals: { form: form, attr: :start_date, label: "Start Date", as: :date } %>
      <%= render partial: "shared/field", locals: { form: form, attr: :end_date, label: "End Date", as: :date } %>
      <%= render partial: "shared/field", locals: { form: form, attr: :assigned_to, label: "Assigned To" } %>
      <%= render partial: "shared/field", locals: {
            form: form, attr: :estimated_value, label: "Estimated Value ($)", as: :number,
            options: { step: "0.01", min: 0 }
          } %>
    </div>
  </fieldset>

  <fieldset class="mb-6">
    <legend class="text-sm font-semibold text-base-content uppercase tracking-wide mb-3">Job Site Address</legend>
    <div class="space-y-4">
      <%= render partial: "shared/field", locals: { form: form, attr: :address_line_1, label: "Address Line 1" } %>
      <%= render partial: "shared/field", locals: { form: form, attr: :address_line_2, label: "Address Line 2" } %>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <%= render partial: "shared/field", locals: { form: form, attr: :city } %>
        <%= render partial: "shared/field", locals: { form: form, attr: :province } %>
        <%= render partial: "shared/field", locals: { form: form, attr: :postal_code, label: "Postal Code" } %>
      </div>
    </div>
  </fieldset>

  <fieldset class="mb-6">
    <legend class="text-sm font-semibold text-base-content uppercase tracking-wide mb-3">Description</legend>
    <%= render partial: "shared/field", locals: { form: form, attr: :description, as: :textarea } %>
  </fieldset>

  <%= form.submit class: "btn btn-primary", data: { turbo_submits_with: "Saving…" } %>
<% end %>
