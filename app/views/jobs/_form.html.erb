<%= form_with(model: job, class: "contents") do |form| %>
  <% if job.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(job.errors.count, "error") %> prohibited this job from being saved:</h2>

      <ul class="list-disc ml-6">
        <% job.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :title %>
    <%= form.text_field :title, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": job.errors[:title].none?, "border-red-400 focus:outline-red-600": job.errors[:title].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :status %>
    <%= form.text_field :status, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": job.errors[:status].none?, "border-red-400 focus:outline-red-600": job.errors[:status].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :job_type %>
    <%= form.text_field :job_type, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": job.errors[:job_type].none?, "border-red-400 focus:outline-red-600": job.errors[:job_type].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :source %>
    <%= form.text_field :source, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": job.errors[:source].none?, "border-red-400 focus:outline-red-600": job.errors[:source].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :estimated_value %>
    <%= form.text_field :estimated_value, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": job.errors[:estimated_value].none?, "border-red-400 focus:outline-red-600": job.errors[:estimated_value].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :assigned_to %>
    <%= form.text_field :assigned_to, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": job.errors[:assigned_to].none?, "border-red-400 focus:outline-red-600": job.errors[:assigned_to].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :description %>
    <%= form.textarea :description, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": job.errors[:description].none?, "border-red-400 focus:outline-red-600": job.errors[:description].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :customer_id %>
    <%= form.text_field :customer_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": job.errors[:customer_id].none?, "border-red-400 focus:outline-red-600": job.errors[:customer_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :lead_id %>
    <%= form.text_field :lead_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": job.errors[:lead_id].none?, "border-red-400 focus:outline-red-600": job.errors[:lead_id].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
