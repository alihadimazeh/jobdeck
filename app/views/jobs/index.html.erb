<% content_for :title, "Jobs" %>

<%= render partial: "shared/page_header", locals: {
      title: "Jobs",
      action: (policy(Job).create? ? { label: "New Job", path: new_job_path } : nil)
    } %>

<%# The dashboard's "View all active jobs" arrives sorted by urgency (end date, then start date),
    the same order as Job.by_urgency. The sort has no control on this page, so say it's on. %>
<% sorts = Array(params.dig(:q, :s)) %>
<% if sorts.first == "end_date asc" %>
  <p class="mb-4 text-sm text-base-content/70">
    Most urgent first: jobs past their end date, then the nearest end date.
    <%= link_to "Default order", jobs_path(q: params[:q].to_unsafe_h.except("s")), class: "link link-primary" %>
  </p>
<% end %>

<%= search_form_for @q, url: jobs_path, class: "mb-4 flex gap-2 max-w-lg" do |f| %>
  <%# Keep the urgency sort across a search. %>
  <% sorts.each do |sort| %>
    <%= hidden_field_tag "q[s][]", sort, id: nil %>
  <% end %>
  <%= f.label :title_or_customer_first_name_or_customer_last_name_cont, "Search jobs", class: "sr-only" %>
  <%= f.search_field :title_or_customer_first_name_or_customer_last_name_cont,
        class: "input input-sm w-full", placeholder: "Search jobs…" %>
  <%# Ransack's *_eq predicate needs the enum's integer value, not its label - see
      leads/index.html.erb for the bug this guards against. %>
  <%= f.label :status_eq, "Filter by status", class: "sr-only" %>
  <%= f.select :status_eq, Job.statuses.map { |key, value| [ key.titleize, value ] },
        { include_blank: "Any status" }, class: "select select-sm" %>
  <%= f.submit "Search", class: "btn btn-sm" %>
<% end %>

<%= render "shared/table", { columns: [ "Title", { label: "Customer", class: "max-sm:hidden" },
      { label: "Status", class: "max-sm:hidden" }, { label: "Start Date", class: "max-sm:hidden" }, "Ends", "" ] } do %>
  <% if @jobs.any? %>
    <%= render partial: "jobs/job", collection: @jobs, locals: { show_end_date: true } %>
  <% elsif @q.conditions.any? %>
    <%= render partial: "shared/empty_state", locals: {
          title: "No jobs match your search.", colspan: 6,
          cta: { label: "Clear search", path: jobs_path }
        } %>
  <% else %>
    <%= render partial: "shared/empty_state", locals: {
          title: "No jobs yet.", colspan: 6,
          cta: (policy(Job).create? ? { label: "Add the first one", path: new_job_path } : nil)
        } %>
  <% end %>
<% end %>

<%== @pagy.series_nav if @pagy.pages > 1 %>
