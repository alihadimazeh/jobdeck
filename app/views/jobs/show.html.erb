<% content_for :title, @job.title %>
<% content_for :breadcrumbs do %>
  <%= link_to "Jobs", jobs_path %> &rsaquo; <%= @job.title %>
<% end %>
<% content_for :page_heading, @job.title %>

<%# Job details %>
<div class="bg-white rounded-lg border border-gray-200 p-6 mb-6">
  <div class="flex justify-between items-start">
    <div class="grid grid-cols-2 gap-x-12 gap-y-4 flex-1">
      <div>
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Customer</p>
        <p class="text-sm text-gray-900"><%= link_to @job.customer.full_name, @job.customer, class: "hover:text-amber-600" %></p>
      </div>
      <div>
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Status</p>
        <% badge_classes = { "active" => "bg-green-100 text-green-700", "on_hold" => "bg-amber-100 text-amber-700", "completed" => "bg-blue-100 text-blue-700", "cancelled" => "bg-red-100 text-red-600" } %>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-semibold uppercase tracking-wide <%= badge_classes[@job.status] || "bg-gray-100 text-gray-600" %>">
          <%= @job.status.humanize %>
        </span>
      </div>
      <div>
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Job Type</p>
        <p class="text-sm text-gray-900"><%= @job.job_type&.titleize || "—" %></p>
      </div>
      <div>
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Assigned To</p>
        <p class="text-sm text-gray-900"><%= @job.assigned_to.presence || "—" %></p>
      </div>
      <div>
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Estimated Value</p>
        <p class="text-sm text-gray-900"><%= @job.estimated_value ? number_to_currency(@job.estimated_value) : "—" %></p>
      </div>
      <div>
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Start Date</p>
        <p class="text-sm text-gray-900"><%= @job.start_date&.strftime("%b %d, %Y") || "—" %></p>
      </div>
      <div>
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">End Date</p>
        <p class="text-sm text-gray-900"><%= @job.end_date&.strftime("%b %d, %Y") || "—" %></p>
      </div>
      <div>
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Job Site</p>
        <p class="text-sm text-gray-900">
          <% if @job.address_line_1.present? %>
            <%= @job.address_line_1 %><br>
            <% if @job.address_line_2.present? %>
              <%= @job.address_line_2 %><br>
            <% end %>
            <%= [@job.city, @job.province, @job.postal_code].compact_blank.join(", ") %>
          <% else %>
            —
          <% end %>
        </p>
      </div>
      <% if @job.description.present? %>
        <div class="col-span-2">
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Description</p>
          <p class="text-sm text-gray-900"><%= @job.description %></p>
        </div>
      <% end %>
    </div>
    <%= link_to "Edit", edit_job_path(@job), class: "text-sm font-medium text-gray-500 hover:text-gray-700 ml-6" %>
  </div>
</div>

<%# Originating lead %>
<% if @job.lead.present? %>
  <div class="bg-white rounded-lg border border-gray-200 overflow-hidden mb-6">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-sm font-semibold text-gray-700">Originated From</h2>
    </div>
    <table class="min-w-full divide-y divide-gray-100">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Lead</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Status</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Source</th>
        </tr>
      </thead>
      <tbody>
        <tr class="hover:bg-gray-50">
          <td class="px-6 py-4 text-sm font-medium text-gray-900">
            <%= link_to @job.lead.title, @job.lead, class: "hover:text-amber-600" %>
          </td>
          <td class="px-6 py-4">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-semibold uppercase tracking-wide bg-green-100 text-green-700">
              <%= @job.lead.status %>
            </span>
          </td>
          <td class="px-6 py-4 text-sm text-gray-500">
            <%= @job.lead.source&.titleize || "—" %>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
<% end %>

<%# Orders %>
<div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
  <div class="flex justify-between items-center px-6 py-4 border-b border-gray-200">
    <h2 class="text-sm font-semibold text-gray-700">Orders</h2>
  </div>
  <p class="px-6 py-8 text-sm text-gray-400 text-center">No orders yet.</p>
</div>
