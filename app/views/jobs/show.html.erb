<% content_for :title, @job.title %>

<% actions = capture do %>
  <%= link_to "Edit", edit_job_path(@job), class: "btn btn-ghost btn-sm" %>
  <%= button_to "Delete", @job, method: :delete,
        form: { data: { turbo_confirm: "Are you sure you want to delete this job?" } },
        class: "btn btn-ghost btn-sm text-error" %>
<% end %>

<%= render partial: "shared/page_header", locals: {
      title: @job.title,
      breadcrumbs: [ [ "Jobs", jobs_path ] ],
      actions: actions
    } %>

<%# Job details %>
<div class="mb-6">
  <%= render "shared/card" do %>
    <%= render partial: "shared/detail_list", locals: { items: [
          [ "Customer", link_to(@job.customer.full_name, @job.customer, class: "hover:text-primary") ],
          [ "Status", status_badge(@job) ],
          [ "Job Type", @job.job_type&.titleize ],
          [ "Assigned To", @job.assigned_to ],
          [ "Estimated Value", format_currency(@job.estimated_value) ],
          [ "Start Date", format_date(@job.start_date) ],
          [ "End Date", format_date(@job.end_date) ],
          [ "Job Site", format_address(
              address_line_1: @job.address_line_1, address_line_2: @job.address_line_2,
              city: @job.city, province: @job.province, postal_code: @job.postal_code
            ) ]
        ] } %>
    <% if @job.description.present? %>
      <div class="mt-4 pt-4 border-t border-base-300">
        <p class="text-xs font-semibold uppercase tracking-wide text-base-content/70 mb-1">Description</p>
        <p class="text-sm text-base-content"><%= @job.description %></p>
      </div>
    <% end %>
  <% end %>
</div>

<%# Originating lead %>
<% if @job.lead.present? %>
  <div class="mb-6">
    <%= render "shared/card", { title: "Originated From", padded: false } do %>
      <%# Hand-rolled on purpose: shows Source (how the work came in) instead of
          leads/_lead's follow-up date, which is meaningless once a job exists. %>
      <%= render "shared/table", { columns: [ "Lead", "Status", "Source" ] } do %>
        <tr class="hover">
          <td class="font-medium text-base-content">
            <%= link_to @job.lead.title, @job.lead, class: "hover:text-primary" %>
          </td>
          <td><%= status_badge(@job.lead) %></td>
          <td class="text-base-content/70"><%= @job.lead.source&.titleize || "—" %></td>
        </tr>
      <% end %>
    <% end %>
  </div>
<% end %>

<%# Orders %>
<% order_actions = capture do %>
  <%= link_to "New Order", new_job_order_path(@job), class: "btn btn-ghost btn-sm text-primary" %>
<% end %>

<%= render "shared/card", { title: "Orders", actions: order_actions, padded: false } do %>
  <%= render "shared/table", { columns: [ "Order #", "Status", "Total" ] } do %>
    <% if @job.orders.any? %>
      <% @job.orders.order(created_at: :desc).each do |order| %>
        <tr class="hover">
          <td class="font-medium text-base-content">
            <%= link_to order.order_number, order, class: "hover:text-primary" %>
          </td>
          <td><%= status_badge(order) %></td>
          <td class="text-base-content/70"><%= format_currency(order.total) %></td>
        </tr>
      <% end %>
    <% else %>
      <%= render partial: "shared/empty_state", locals: { title: "No orders yet.", colspan: 3 } %>
    <% end %>
  <% end %>
<% end %>

<%# Activity notes %>
<div class="mt-6">
  <%= render "activity_notes/section", notable: @job %>
</div>

<%# Documents %>
<div class="mt-6">
  <%= render "documents/section", documentable: @job %>
</div>
