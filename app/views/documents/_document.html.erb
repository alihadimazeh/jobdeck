<% viewable_inline = document.file.content_type == "application/pdf" || document.file.image? %>
<% name = document.label.presence || document.file.filename.to_s %>
<div id="<%= dom_id(document) %>" class="flex items-start justify-between gap-3 py-3 border-b border-base-300 last:border-0">
  <div class="flex items-start gap-3 min-w-0">
    <% if document.file.image? %>
      <%# Original blob, not a variant: libvips isn't installed in every dev environment
          (the Dockerfile has it), and a missing processor would break the thumbnail. %>
      <%= link_to rails_blob_path(document.file, disposition: "inline"), target: "_blank", rel: "noopener",
            class: "shrink-0", tabindex: "-1", "aria-hidden": "true" do %>
        <%= image_tag rails_blob_path(document.file, disposition: "inline"), alt: "",
              loading: "lazy", class: "size-12 rounded object-cover border border-base-300" %>
      <% end %>
    <% end %>
    <div class="min-w-0">
      <p class="text-sm font-medium text-base-content"><%= name %></p>
      <p class="text-xs text-base-content/70 mt-1 flex items-center gap-2">
        <%= render "shared/badge", label: (document.document_type || "other").titleize, variant: :neutral %>
        <span><%= number_to_human_size(document.file.byte_size) %></span>
        <% if viewable_inline %>
          <%= link_to "View", rails_blob_path(document.file, disposition: "inline"),
                target: "_blank", rel: "noopener", class: "link link-primary",
                "aria-label": "View #{name} (opens in a new tab)" %>
        <% else %>
          <%= link_to "Download", rails_blob_path(document.file, disposition: "attachment"), class: "link link-primary" %>
        <% end %>
      </p>
    </div>
  </div>
  <%= render partial: "shared/row_actions", locals: {
        delete_path: document_path(document),
        delete_confirm: "Are you sure you want to delete this document?",
        label: name,
        id: dom_id(document)
      } %>
</div>
