<div id="<%= dom_id(document) %>" class="flex items-start justify-between gap-3 py-3 border-b border-base-300 last:border-0">
  <div>
    <p class="text-sm font-medium text-base-content"><%= document.label.presence || document.file.filename %></p>
    <p class="text-xs text-base-content/70 mt-1 flex items-center gap-2">
      <%= render "shared/badge", label: (document.document_type || "other").titleize, variant: :neutral %>
      <span><%= number_to_human_size(document.file.byte_size) %></span>
      <% if document.file.content_type == "application/pdf" %>
        <%= link_to "View", rails_blob_path(document.file, disposition: "inline"),
              target: "_blank", rel: "noopener", class: "link link-primary" %>
      <% else %>
        <%= link_to "Download", rails_blob_path(document.file, disposition: "attachment"), class: "link link-primary" %>
      <% end %>
    </p>
  </div>
  <%= render partial: "shared/row_actions", locals: {
        delete_path: document_path(document),
        delete_confirm: "Are you sure you want to delete this document?",
        label: document.label.presence || document.file.filename.to_s,
        id: dom_id(document)
      } %>
</div>
