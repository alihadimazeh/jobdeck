<%= form_with model: customer do |form| %>
  <%= render partial: "shared/form_errors", locals: { model: customer } %>

  <%# Personal details %>
  <fieldset class="mb-6">
    <legend class="text-sm font-semibold text-base-content uppercase tracking-wide mb-3">Personal Details</legend>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <%= render partial: "shared/field", locals: { form: form, attr: :first_name } %>
      <%= render partial: "shared/field", locals: { form: form, attr: :last_name } %>
      <%= render partial: "shared/field", locals: { form: form, attr: :phone, as: :phone } %>
      <%= render partial: "shared/field", locals: { form: form, attr: :email, as: :email } %>
    </div>
  </fieldset>

  <%# Address %>
  <fieldset class="mb-6">
    <legend class="text-sm font-semibold text-base-content uppercase tracking-wide mb-3">Address</legend>
    <div class="space-y-4">
      <%= render partial: "shared/field", locals: { form: form, attr: :address_line_1, label: "Address Line 1" } %>
      <%= render partial: "shared/field", locals: { form: form, attr: :address_line_2, label: "Address Line 2" } %>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <%= render partial: "shared/field", locals: { form: form, attr: :city } %>
        <%= render partial: "shared/field", locals: { form: form, attr: :province } %>
        <%= render partial: "shared/field", locals: { form: form, attr: :postal_code, label: "Postal Code" } %>
      </div>
    </div>
  </fieldset>

  <%# Other %>
  <fieldset class="mb-6">
    <legend class="text-sm font-semibold text-base-content uppercase tracking-wide mb-3">Other</legend>
    <div class="space-y-4">
      <%= render partial: "shared/field", locals: {
            form: form, attr: :status, as: :select,
            collection: [ [ "Active", "active" ], [ "Inactive", "inactive" ] ]
          } %>
      <%= render partial: "shared/field", locals: { form: form, attr: :notes, as: :textarea } %>
    </div>
  </fieldset>

  <%= form.submit class: "btn btn-primary", data: { turbo_submits_with: "Saving…" } %>
<% end %>
