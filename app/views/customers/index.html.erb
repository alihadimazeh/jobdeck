<% content_for :title, "Customers" %>

<%= render partial: "shared/page_header", locals: {
      title: "Customers",
      action: { label: "New Customer", path: new_customer_path }
    } %>

<%= render "shared/table", { columns: [ "Name", "Phone", "Email", "Status", "" ] } do %>
  <% if @customers.any? %>
    <%= render @customers %>
  <% else %>
    <%= render partial: "shared/empty_state", locals: {
          title: "No customers yet.", colspan: 5,
          cta: { label: "Add the first one", path: new_customer_path }
        } %>
  <% end %>
<% end %>
