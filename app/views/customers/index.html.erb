<% content_for :title, "Customers" %>

<%= render partial: "shared/page_header", locals: {
      title: "Customers",
      action: (policy(Customer).create? ? { label: "New Customer", path: new_customer_path } : nil)
    } %>

<%= search_form_for @q, url: customers_path, class: "mb-4 flex gap-2 max-w-sm" do |f| %>
  <%= f.label :first_name_or_last_name_or_phone_or_email_cont, "Search customers", class: "sr-only" %>
  <%= f.search_field :first_name_or_last_name_or_phone_or_email_cont,
        class: "input input-sm w-full", placeholder: "Search customers…" %>
  <%= f.submit "Search", class: "btn btn-sm" %>
<% end %>

<%= render "shared/table", { columns: [ "Name", "Phone", "Email", "Status", "" ] } do %>
  <% if @customers.any? %>
    <%= render @customers %>
  <% elsif @q.conditions.any? %>
    <%= render partial: "shared/empty_state", locals: {
          title: "No customers match your search.", colspan: 5,
          cta: { label: "Clear search", path: customers_path }
        } %>
  <% else %>
    <%= render partial: "shared/empty_state", locals: {
          title: "No customers yet.", colspan: 5,
          cta: (policy(Customer).create? ? { label: "Add the first one", path: new_customer_path } : nil)
        } %>
  <% end %>
<% end %>

<%== @pagy.series_nav if @pagy.pages > 1 %>
