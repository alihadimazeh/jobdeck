<% content_for :title, @customer.full_name %>
<% content_for :breadcrumbs do %>
  <%= link_to "Customers", customers_path %> &rsaquo; <%= @customer.full_name %>
<% end %>
<% content_for :page_heading, @customer.full_name %>

<%# Customer details %>
<div class="bg-white rounded-lg border border-gray-200 p-6 mb-6">
  <div class="flex justify-between items-start">
    <div class="grid grid-cols-2 gap-x-12 gap-y-4">
      <div>
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Phone</p>
        <p class="text-sm text-gray-900"><%= @customer.phone %></p>
      </div>
      <div>
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Email</p>
        <p class="text-sm text-gray-900"><%= @customer.email.presence || "—" %></p>
      </div>
      <div>
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Address</p>
        <p class="text-sm text-gray-900">
          <% if @customer.address_line_1.present? %>
            <%= @customer.address_line_1 %><br>
            <% if @customer.address_line_2.present? %>
              <%= @customer.address_line_2 %><br>
            <% end %>
            <%= [@customer.city, @customer.province, @customer.postal_code].compact_blank.join(", ") %>
          <% else %>
            —
          <% end %>
        </p>
      </div>
      <div>
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Status</p>
        <% badge_class = { "active" => "bg-green-100 text-green-700", "inactive" => "bg-gray-100 text-gray-500", "archived" => "bg-red-100 text-red-700" }[@customer.status] %>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-semibold uppercase tracking-wide <%= badge_class %>">
          <%= @customer.status %>
        </span>
      </div>
    </div>
    <div class="flex items-center gap-3 ml-6 flex-shrink-0">
      <%= link_to "Edit", edit_customer_path(@customer), class: "text-sm font-medium text-gray-500 hover:text-gray-700" %>
      <%= button_to "Delete", @customer, method: :delete,
            form: { data: { turbo_confirm: "Are you sure you want to delete #{@customer.full_name}?" } },
            class: "text-sm font-medium text-red-500 hover:text-red-700 bg-transparent border-0 cursor-pointer p-0" %>
    </div>
  </div>
</div>

<%# Stat cards %>
<div class="grid grid-cols-4 gap-4 mb-6">
  <div class="bg-white rounded-lg border border-gray-200 p-4">
    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Active Jobs</p>
    <p class="text-2xl font-semibold text-gray-900"><%= @customer.jobs.count %></p>
  </div>
  <div class="bg-white rounded-lg border border-gray-200 p-4">
    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Leads</p>
    <p class="text-2xl font-semibold text-gray-900"><%= @customer.leads.count %></p>
  </div>
  <div class="bg-white rounded-lg border border-gray-200 p-4">
    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Lifetime Value</p>
    <p class="text-2xl font-semibold text-gray-400">—</p>
  </div>
  <div class="bg-white rounded-lg border border-gray-200 p-4">
    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Outstanding</p>
    <p class="text-2xl font-semibold text-gray-400">—</p>
  </div>
</div>

<%# Leads section %>
<div class="bg-white rounded-lg border border-gray-200 overflow-hidden mb-6">
  <div class="flex justify-between items-center px-6 py-4 border-b border-gray-200">
    <h2 class="text-sm font-semibold text-gray-700">Leads</h2>
  </div>
  <% if @customer.leads.any? %>
    <table class="min-w-full divide-y divide-gray-100">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Title</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Status</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Follow-up</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @customer.leads.each do |lead| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 text-sm font-medium text-gray-900">
              <%= link_to lead.title, lead, class: "hover:text-amber-600" %>
            </td>
            <td class="px-6 py-4">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-semibold uppercase tracking-wide bg-gray-100 text-gray-600">
                <%= lead.status %>
              </span>
            </td>
            <td class="px-6 py-4 text-sm text-gray-500">
              <%= lead.follow_up_date&.strftime("%b %d, %Y") || "—" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="px-6 py-8 text-sm text-gray-400 text-center">No leads yet.</p>
  <% end %>
</div>

<%# Jobs section %>
<div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
  <div class="flex justify-between items-center px-6 py-4 border-b border-gray-200">
    <h2 class="text-sm font-semibold text-gray-700">Jobs</h2>
  </div>
  <% if @customer.jobs.any? %>
    <table class="min-w-full divide-y divide-gray-100">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Title</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Status</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Start Date</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @customer.jobs.each do |job| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 text-sm font-medium text-gray-900">
              <%= link_to job.title, job, class: "hover:text-amber-600" %>
            </td>
            <td class="px-6 py-4">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-semibold uppercase tracking-wide bg-gray-100 text-gray-600">
                <%= job.status %>
              </span>
            </td>
            <td class="px-6 py-4 text-sm text-gray-500">
              <%= job.start_date&.strftime("%b %d, %Y") || "—" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="px-6 py-8 text-sm text-gray-400 text-center">No jobs yet.</p>
  <% end %>
</div>
