<% content_for :title, @customer.full_name %>

<% actions = capture do %>
  <%= link_to "Edit", edit_customer_path(@customer), class: "btn btn-ghost btn-sm" %>
  <%= button_to "Delete", @customer, method: :delete,
        form: { data: { turbo_confirm: "Are you sure you want to delete #{@customer.full_name}?" } },
        class: "btn btn-ghost btn-sm text-error" %>
<% end %>

<%= render partial: "shared/page_header", locals: {
      title: @customer.full_name,
      breadcrumbs: [ [ "Customers", customers_path ] ],
      actions: actions
    } %>

<%# Customer details %>
<div class="mb-6">
  <%= render "shared/card" do %>
    <%= render partial: "shared/detail_list", locals: { items: [
          [ "Phone", @customer.phone ],
          [ "Email", @customer.email ],
          [ "Address", format_address(
              address_line_1: @customer.address_line_1, address_line_2: @customer.address_line_2,
              city: @customer.city, province: @customer.province, postal_code: @customer.postal_code
            ) ],
          [ "Status", status_badge(@customer) ]
        ] } %>
  <% end %>
</div>

<%# Stat cards %>
<div class="mb-6">
  <%= render partial: "shared/stats", locals: { items: [
        { title: "Active Jobs", value: @customer.jobs.count },
        { title: "Leads", value: @customer.leads.count },
        { title: "Lifetime Value", value: "—" },
        { title: "Outstanding", value: "—" }
      ] } %>
</div>

<%# Leads section %>
<div class="mb-6">
  <%= render "shared/card", { title: "Leads", padded: false } do %>
    <%= render "shared/table", { columns: [ "Title", "Status", "Follow-up" ] } do %>
      <% if @customer.leads.any? %>
        <% @customer.leads.each do |lead| %>
          <tr class="hover">
            <td class="font-medium text-base-content">
              <%= link_to lead.title, lead, class: "hover:text-primary" %>
            </td>
            <td><%= status_badge(lead) %></td>
            <td class="text-base-content/70"><%= format_date(lead.follow_up_date) %></td>
          </tr>
        <% end %>
      <% else %>
        <%= render partial: "shared/empty_state", locals: { title: "No leads yet.", colspan: 3 } %>
      <% end %>
    <% end %>
  <% end %>
</div>

<%# Jobs section %>
<div>
  <%= render "shared/card", { title: "Jobs", padded: false } do %>
    <%= render "shared/table", { columns: [ "Title", "Status", "Start Date" ] } do %>
      <% if @customer.jobs.any? %>
        <% @customer.jobs.each do |job| %>
          <tr class="hover">
            <td class="font-medium text-base-content">
              <%= link_to job.title, job, class: "hover:text-primary" %>
            </td>
            <td><%= status_badge(job) %></td>
            <td class="text-base-content/70"><%= format_date(job.start_date) %></td>
          </tr>
        <% end %>
      <% else %>
        <%= render partial: "shared/empty_state", locals: { title: "No jobs yet.", colspan: 3 } %>
      <% end %>
    <% end %>
  <% end %>
</div>

<%# Activity notes %>
<div class="mt-6">
  <%= render "activity_notes/section", notable: @customer, activity_note: @activity_note %>
</div>

<%# Documents %>
<div class="mt-6">
  <%= render "documents/section", documentable: @customer, document: @document %>
</div>
