<% content_for :title, "Edit #{@customer.full_name}" %>
<% content_for :breadcrumbs do %>
  <%= link_to "Customers", customers_path %> &rsaquo; <%= link_to @customer.full_name, @customer %> &rsaquo; Edit
<% end %>
<% content_for :page_heading do %>
  Edit <%= @customer.full_name %>
<% end %>

<div class="md:w-2/3 w-full">
  <%= render "form", customer: @customer %>

  <%= link_to "Back to customer", @customer, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
</div>
