<tr id="<%= dom_id(customer) %>" class="hover">
  <td class="font-medium text-base-content">
    <%= link_to customer.full_name, customer, class: "hover:text-primary" %>
  </td>
  <td class="text-base-content/70"><%= customer.phone %></td>
  <td class="text-base-content/70"><%= customer.email.presence || "—" %></td>
  <td><%= status_badge(customer) %></td>
  <td>
    <%= render partial: "shared/row_actions", locals: {
          edit_path: edit_customer_path(customer),
          delete_path: customer_path(customer),
          delete_confirm: "Are you sure you want to delete #{customer.full_name}?",
          label: customer.full_name,
          id: dom_id(customer)
        } %>
  </td>
</tr>
