<% content_for :title, "Dashboard" %>

<%= render partial: "shared/page_header", locals: { title: "Dashboard" } %>

<div class="mb-6">
  <%= render partial: "shared/stats", locals: { items: [
        { title: "Leads Needing Follow-up", value: @follow_up_leads_count },
        { title: "Active Jobs", value: @active_jobs_count },
        { title: "Waiting on Payment", value: format_currency(@awaiting_payment_total),
          desc: pluralize(@awaiting_payment_count, "invoice") }
      ] } %>
</div>

<%# Two columns from lg up: leads beside jobs, then the two order cards. Rows are lists, not
    tables, so the money column fits at any card width - see dashboard/_preview_row. %>
<div class="grid grid-cols-1 lg:grid-cols-2 items-start gap-6">
  <%# Leads needing follow-up %>
  <% leads_actions = capture do %>
    <%= link_to "View all", leads_path, class: "btn btn-ghost btn-sm text-primary" %>
  <% end %>
  <%= render "shared/card", { title: "Leads Needing Follow-up", actions: leads_actions, padded: false } do %>
    <% if @follow_up_leads.any? %>
      <ul class="divide-y divide-base-300 text-sm">
        <% @follow_up_leads.each do |lead| %>
          <%= render "dashboard/preview_row", path: lead, title: lead.title, subtitle: lead.customer.full_name,
                aside: tag.span(format_date(lead.follow_up_date), class: "text-base-content/70") %>
        <% end %>
      </ul>
    <% else %>
      <%= render partial: "shared/empty_state", locals: { title: "Nothing needs follow-up." } %>
    <% end %>
  <% end %>

  <%# Active jobs %>
  <% jobs_actions = capture do %>
    <%= link_to "View all", jobs_path, class: "btn btn-ghost btn-sm text-primary" %>
  <% end %>
  <%= render "shared/card", { title: "Active Jobs", actions: jobs_actions, padded: false } do %>
    <% if @active_jobs.any? %>
      <ul class="divide-y divide-base-300 text-sm">
        <% @active_jobs.each do |job| %>
          <%= render "dashboard/preview_row", path: job, title: job.title, subtitle: job.customer.full_name,
                aside: tag.span(format_date(job.start_date), class: "text-base-content/70") %>
        <% end %>
      </ul>
    <% else %>
      <%= render partial: "shared/empty_state", locals: { title: "No active jobs." } %>
    <% end %>
  <% end %>

  <%# Orders, split by what the money is doing: invoiced and owed to us, or work not billed yet.
      No unscoped orders index exists (orders are nested under Jobs), so neither card has a
      "View all"; the header carries the card's dollar total instead. %>
  <%= render "shared/card", { title: "Waiting on Payment", padded: false,
        actions: tag.span(format_currency(@awaiting_payment_total), class: "font-semibold tabular-nums text-base-content") } do %>
    <% if @awaiting_payment.any? %>
      <ul class="divide-y divide-base-300 text-sm">
        <% @awaiting_payment.each do |order| %>
          <% aside = capture do %>
            <span class="block font-medium text-base-content"><%= format_currency(order.total) %></span>
            <% if (late = order.days_overdue) %>
              <span class="block mt-1"><%= render "shared/badge", label: "#{pluralize(late, "day")} overdue", variant: :error %></span>
            <% else %>
              <span class="block text-base-content/70"><%= order.due_date ? "Due #{format_date(order.due_date)}" : "No due date" %></span>
            <% end %>
          <% end %>
          <%= render "dashboard/preview_row", path: order, title: order.order_number,
                subtitle: order.customer.full_name, aside: aside %>
        <% end %>
      </ul>
    <% else %>
      <%= render partial: "shared/empty_state", locals: { title: "Nothing waiting on payment." } %>
    <% end %>
  <% end %>

  <%= render "shared/card", { title: "Not Yet Billed", padded: false,
        actions: tag.span(format_currency(@to_bill_total), class: "font-semibold tabular-nums text-base-content") } do %>
    <% if @to_bill.any? %>
      <ul class="divide-y divide-base-300 text-sm">
        <% @to_bill.each do |order| %>
          <% aside = capture do %>
            <span class="block font-medium text-base-content"><%= format_currency(order.total) %></span>
            <span class="block mt-1"><%= status_badge(order) %></span>
          <% end %>
          <%= render "dashboard/preview_row", path: order, title: order.order_number,
                subtitle: order.customer.full_name, aside: aside %>
        <% end %>
      </ul>
    <% else %>
      <%= render partial: "shared/empty_state", locals: { title: "Nothing to bill." } %>
    <% end %>
  <% end %>
</div>
