<% content_for :title, "Dashboard" %>

<%# A walk-in or a phone call is the most common thing that starts work, so logging a lead is
    the page's one primary action. %>
<%= render partial: "shared/page_header", locals: {
      title: "Dashboard",
      action: (policy(Lead).create? ? { label: "New Lead", path: new_lead_path } : nil) } %>

<%# A today-sheet, read top to bottom on a phone: who to call, which sites are running, who owes
    us, what still needs billing. No stat strip - each card header carries its own count or
    total, so the first screen on a phone is the follow-up list itself rather than three
    counters repeating the card titles. Two columns from lg up. Rows are lists, not tables, so
    the money column fits at any card width - see dashboard/_preview_row. %>
<div class="grid grid-cols-1 lg:grid-cols-2 items-start gap-6">
  <% leads_actions = capture do %>
    <%= link_to "View all", leads_path, class: "btn btn-ghost btn-sm text-primary" %>
  <% end %>
  <%= render "shared/card", { title: "Follow-ups Due", count: @follow_up_leads_count, actions: leads_actions, padded: false } do %>
    <% if @follow_up_leads.any? %>
      <ul class="divide-y divide-base-300 text-sm">
        <% @follow_up_leads.each do |lead| %>
          <% late = lead.follow_up_days_late %>
          <% aside = capture do %>
            <% if late.positive? %>
              <%= render "shared/badge", label: "#{pluralize(late, "day")} late", variant: :warning %>
            <% else %>
              <span class="font-medium text-base-content">Today</span>
            <% end %>
          <% end %>
          <%= render "dashboard/preview_row", path: lead, title: lead.title, subtitle: lead.customer.full_name,
                aside: aside, call: { phone: lead.customer.phone, name: lead.customer.full_name } %>
        <% end %>
      </ul>
    <% else %>
      <%= render partial: "shared/empty_state", locals: { title: "No follow-ups due." } %>
    <% end %>
  <% end %>

  <% jobs_actions = capture do %>
    <%= link_to "View all", jobs_path, class: "btn btn-ghost btn-sm text-primary" %>
  <% end %>
  <%= render "shared/card", { title: "Active Jobs", count: @active_jobs_count, actions: jobs_actions, padded: false } do %>
    <% if @active_jobs.any? %>
      <ul class="divide-y divide-base-300 text-sm">
        <% @active_jobs.each do |job| %>
          <%# The site, not the billing address - it's where the crew goes, and it tells apart
              two jobs with the same title. Site first, so a phone's truncation cuts the
              customer name rather than the street. %>
          <% site = [ job.address_line_1, job.city ].compact_blank.join(", ") %>
          <%= render "dashboard/preview_row", path: job, title: job.title,
                subtitle: [ site, job.customer.full_name ].compact_blank.join(" · "),
                aside: tag.span(format_date(job.start_date), class: "text-base-content/70") %>
        <% end %>
      </ul>
    <% else %>
      <%= render partial: "shared/empty_state", locals: { title: "No active jobs." } %>
    <% end %>
  <% end %>

  <%# Orders, split by what the money is doing: invoiced and owed to us, or work not billed yet.
      No unscoped orders index exists (orders are nested under Jobs), so neither card has a
      "View all"; the header carries the card's dollar total instead. %>
  <%= render "shared/card", { title: "Waiting on Payment", count: @awaiting_payment_count, padded: false,
        actions: tag.span(format_currency(@awaiting_payment_total), class: "font-semibold tabular-nums text-base-content") } do %>
    <% if @awaiting_payment.any? %>
      <ul class="divide-y divide-base-300 text-sm">
        <% @awaiting_payment.each do |order| %>
          <% aside = capture do %>
            <span class="block font-medium text-base-content"><%= format_currency(order.total) %></span>
            <% if (overdue = order.days_overdue) %>
              <span class="block mt-1"><%= render "shared/badge", label: "#{pluralize(overdue, "day")} overdue", variant: :error %></span>
            <% else %>
              <span class="block text-base-content/70"><%= order.due_date ? "Due #{format_date(order.due_date)}" : "No due date" %></span>
            <% end %>
          <% end %>
          <%= render "dashboard/preview_row", path: order, title: order.order_number,
                subtitle: order.customer.full_name, aside: aside %>
        <% end %>
      </ul>
    <% else %>
      <%= render partial: "shared/empty_state", locals: { title: "Nothing waiting on payment." } %>
    <% end %>
  <% end %>

  <%= render "shared/card", { title: "Not Yet Billed", count: @to_bill_count, padded: false,
        actions: tag.span(format_currency(@to_bill_total), class: "font-semibold tabular-nums text-base-content") } do %>
    <% if @to_bill.any? %>
      <ul class="divide-y divide-base-300 text-sm">
        <% @to_bill.each do |order| %>
          <% aside = capture do %>
            <span class="block font-medium text-base-content"><%= format_currency(order.total) %></span>
            <span class="block mt-1"><%= status_badge(order) %></span>
          <% end %>
          <%= render "dashboard/preview_row", path: order, title: order.order_number,
                subtitle: order.customer.full_name, aside: aside %>
        <% end %>
      </ul>
    <% else %>
      <%= render partial: "shared/empty_state", locals: { title: "Nothing to bill." } %>
    <% end %>
  <% end %>
</div>
