<%#
  locals: columns: (Array<String> or Array<{label:, align:, class:}>; class: e.g. "max-sm:hidden"
          to drop a column on phones - the matching <td>s must carry the same class), footer: nil (captured <tr>...</tr>
          html for a summary/totals row, rendered inside <tfoot>) - block yields the <tbody> rows

  Call as: render "shared/table", { columns: [...] } do ... end (see shared/_card for why)
%>
<div class="overflow-x-auto">
  <table class="table">
    <thead>
      <tr>
        <% columns.each do |column| %>
          <% label, align, klass = column.is_a?(Hash) ? column.values_at(:label, :align, :class) : [ column, nil, nil ] %>
          <th class="<%= [ ("text-#{align}" if align), klass ].compact.join(" ") %>"><%= label %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <%= yield %>
    </tbody>
    <% if local_assigns[:footer].present? %>
      <tfoot><%= footer %></tfoot>
    <% end %>
  </table>
</div>
