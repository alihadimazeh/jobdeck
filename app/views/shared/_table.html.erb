<%#
  locals: columns: (Array<String> or Array<{label:, align:}>), footer: nil (captured <tr>...</tr>
          html for a summary/totals row, rendered inside <tfoot>) - block yields the <tbody> rows

  Call as: render "shared/table", { columns: [...] } do ... end (see shared/_card for why)
%>
<div class="overflow-x-auto">
  <table class="table">
    <thead>
      <tr>
        <% columns.each do |column| %>
          <% label, align = column.is_a?(Hash) ? [column[:label], column[:align]] : [column, nil] %>
          <th class="<%= "text-#{align}" if align %>"><%= label %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <%= yield %>
    </tbody>
    <% if local_assigns[:footer].present? %>
      <tfoot><%= footer %></tfoot>
    <% end %>
  </table>
</div>
