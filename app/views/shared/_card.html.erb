<%#
  locals: title: nil, actions: nil (captured html), padded: true,
          count: nil (shown muted after the title, e.g. a dashboard card's true total)

  Call as: render "shared/card", { title: "Rooms" } do ... end
  NOT: render partial: "shared/card", locals: { title: "Rooms" } do ... end
  The explicit `partial:`/`locals:` keyword form does not support a block the
  same way - it treats the block as a per-object collection layout and raises
  ("'nil' is not an ActiveModel-compatible object") since no object/collection
  is given. Only the bare-string-plus-plain-hash form reaches this via yield.
%>
<% padded = local_assigns.fetch(:padded, true) %>
<div class="card card-border bg-base-100">
  <% if local_assigns[:title].present? || local_assigns[:actions].present? %>
    <div class="flex items-center justify-between gap-3 px-6 py-4 border-b border-base-300">
      <h2 class="text-sm font-semibold text-base-content">
        <%= title if local_assigns[:title].present? %>
        <% unless local_assigns[:count].nil? %>
          <span class="ml-1.5 font-normal tabular-nums text-base-content/70"><%= count %></span>
        <% end %>
      </h2>
      <%# min-h-11 matches a btn-sm's 44px, so a header with a plain-text action (a total) is the
          same height as one with a "View all" button and side-by-side cards line up. %>
      <% if local_assigns[:actions].present? %>
        <div class="flex items-center min-h-11"><%= actions %></div>
      <% end %>
    </div>
  <% end %>
  <div class="<%= "card-body" if padded %>">
    <%= yield %>
  </div>
</div>
