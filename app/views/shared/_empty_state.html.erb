<%#
  locals: title:, message: nil, icon: nil (captured svg html), cta: ({label:,path:} or nil),
          colspan: nil (wraps in <tr><td colspan="..."> for use inside a table body, else a plain <div>)
%>
<% content = capture do %>
  <div class="text-center py-10">
    <% if local_assigns[:icon].present? %>
      <div class="flex justify-center mb-2" aria-hidden="true"><%= icon %></div>
    <% end %>
    <p class="text-sm font-medium text-base-content"><%= title %></p>
    <% if local_assigns[:message].present? %>
      <p class="text-sm text-base-content/70 mt-1"><%= message %></p>
    <% end %>
    <% if local_assigns[:cta].present? %>
      <div class="mt-3"><%= btn cta[:label], cta[:path], variant: :ghost %></div>
    <% end %>
  </div>
<% end %>

<% if local_assigns[:colspan].present? %>
  <tr>
    <td colspan="<%= colspan %>"><%= content %></td>
  </tr>
<% else %>
  <%= content %>
<% end %>
