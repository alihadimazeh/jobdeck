<%# locals: edit_path: nil, delete_path:, delete_confirm:, label:, id: (unique per row, e.g. dom_id(record)),
          turbo_frame: nil (delete-button escape hatch - set to "_top" when this partial renders
          inside a <turbo-frame>, e.g. ActivityNotes, so the delete request isn't frame-scoped
          against a frame id that won't exist in the response once the record is gone)

          edit_path is optional - omit it for a destroy-only resource (e.g. Documents,
          where re-uploading beats an in-place edit) and the Edit item is skipped. %>
<div class="text-center">
  <button type="button"
          class="btn btn-ghost btn-sm btn-square"
          popovertarget="row-actions-<%= id %>"
          style="anchor-name:--row-actions-<%= id %>"
          aria-label="Actions for <%= label %>">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
      <circle cx="12" cy="5" r="1.5"/>
      <circle cx="12" cy="12" r="1.5"/>
      <circle cx="12" cy="19" r="1.5"/>
    </svg>
  </button>

  <ul popover
      id="row-actions-<%= id %>"
      class="dropdown menu w-36 bg-base-100 rounded-box shadow border border-base-300 p-1"
      style="position-anchor:--row-actions-<%= id %>">
    <% if local_assigns[:edit_path].present? %>
      <li><%= link_to "Edit", edit_path %></li>
    <% end %>
    <li>
      <%= button_to "Delete", delete_path, method: :delete,
            form: { data: { turbo_confirm: delete_confirm, turbo_frame: local_assigns[:turbo_frame] }.compact },
            class: "text-error w-full text-left" %>
    </li>
  </ul>
</div>
