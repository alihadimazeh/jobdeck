<tr id="<%= dom_id(order) %>" class="hover">
  <td class="font-medium text-base-content">
    <%= link_to order.order_number, order, class: "hover:text-primary" %>
  </td>
  <td><%= status_badge(order) %></td>
  <td class="text-base-content/70"><%= format_date(order.issued_date) %></td>
  <td class="font-medium text-base-content"><%= format_currency(order.total) %></td>
  <td>
    <%= render partial: "shared/row_actions", locals: {
          edit_path: edit_order_path(order),
          delete_path: order_path(order),
          delete_confirm: "Are you sure you want to delete this order?",
          label: order.order_number,
          id: dom_id(order)
        } %>
  </td>
</tr>
