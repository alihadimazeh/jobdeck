<% content_for :title, @order.order_number %>
<% content_for :breadcrumbs do %>
  <%= link_to "Jobs", jobs_path %> &rsaquo; <%= link_to @order.job.title, @order.job %> &rsaquo; <%= @order.order_number %>
<% end %>
<% content_for :page_heading, @order.order_number %>

<%# Order details %>
<div class="bg-white rounded-lg border border-gray-200 p-6 mb-6">
  <div class="flex justify-between items-start">
    <div class="grid grid-cols-2 gap-x-12 gap-y-4 flex-1">
      <div>
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Customer</p>
        <p class="text-sm text-gray-900"><%= link_to @order.customer.full_name, @order.customer, class: "hover:text-amber-600" %></p>
      </div>
      <div>
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Status</p>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-semibold uppercase tracking-wide <%= order_status_badge_classes(@order.status) %>">
          <%= @order.status %>
        </span>
      </div>
      <div>
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Issued Date</p>
        <p class="text-sm text-gray-900"><%= @order.issued_date&.strftime("%b %d, %Y") || "—" %></p>
      </div>
      <div>
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Due Date</p>
        <p class="text-sm text-gray-900"><%= @order.due_date&.strftime("%b %d, %Y") || "—" %></p>
      </div>
      <div>
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Subtotal</p>
        <p class="text-sm text-gray-900"><%= number_to_currency(@order.subtotal) %></p>
      </div>
      <div>
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Tax Rate</p>
        <p class="text-sm text-gray-900"><%= number_to_percentage(@order.tax_rate.to_f * 100, precision: 2) %></p>
      </div>
      <div>
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Total</p>
        <p class="text-sm text-gray-900 font-semibold"><%= number_to_currency(@order.total) %></p>
      </div>
      <% if @order.notes.present? %>
        <div class="col-span-2">
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Notes</p>
          <p class="text-sm text-gray-900"><%= @order.notes %></p>
        </div>
      <% end %>
    </div>
    <div class="flex items-center gap-3 ml-6 flex-shrink-0">
      <%= link_to "Edit", edit_order_path(@order), class: "text-sm font-medium text-gray-500 hover:text-gray-700" %>
      <%= button_to "Delete", @order, method: :delete,
            form: { data: { turbo_confirm: "Are you sure you want to delete this order?" } },
            class: "text-sm font-medium text-red-500 hover:text-red-700 bg-transparent border-0 cursor-pointer p-0" %>
    </div>
  </div>
</div>

<%# Line items %>
<div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
  <div class="px-6 py-4 border-b border-gray-200">
    <h2 class="text-sm font-semibold text-gray-700">Line Items</h2>
  </div>
  <% if @order.line_items.any? %>
    <table class="min-w-full divide-y divide-gray-100">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Type</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Description</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Qty</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Unit</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Unit Price</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Total</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @order.line_items.each do |line_item| %>
          <tr>
            <td class="px-6 py-4 text-sm text-gray-500"><%= line_item.item_type.titleize %></td>
            <td class="px-6 py-4 text-sm font-medium text-gray-900"><%= line_item.description %></td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= line_item.quantity %></td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= line_item.unit %></td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= number_to_currency(line_item.unit_price) %></td>
            <td class="px-6 py-4 text-sm text-gray-900 font-medium"><%= number_to_currency(line_item.total) %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr class="bg-gray-50">
          <td colspan="5" class="px-6 py-3 text-sm font-semibold text-gray-700 text-right">Total</td>
          <td class="px-6 py-3 text-sm font-semibold text-gray-900"><%= number_to_currency(@order.total) %></td>
        </tr>
      </tfoot>
    </table>
  <% else %>
    <p class="px-6 py-8 text-sm text-gray-400 text-center">No line items added yet.</p>
  <% end %>
</div>
