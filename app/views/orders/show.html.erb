<% content_for :title, @order.order_number %>

<% actions = capture do %>
  <%= link_to "Edit", edit_order_path(@order), class: "btn btn-ghost btn-sm" %>
  <%= button_to "Delete", @order, method: :delete,
        form: { data: { turbo_confirm: "Are you sure you want to delete this order?" } },
        class: "btn btn-ghost btn-sm text-error" %>
<% end %>

<%= render partial: "shared/page_header", locals: {
      title: @order.order_number,
      breadcrumbs: [ [ "Jobs", jobs_path ], [ @order.job.title, job_path(@order.job) ] ],
      actions: actions
    } %>

<%# Order details %>
<div class="mb-6">
  <%= render "shared/card" do %>
    <%= render partial: "shared/detail_list", locals: { items: [
          [ "Customer", link_to(@order.customer.full_name, @order.customer, class: "hover:text-primary") ],
          [ "Status", status_badge(@order) ],
          [ "Issued Date", format_date(@order.issued_date) ],
          [ "Due Date", format_date(@order.due_date) ],
          [ "Subtotal", format_currency(@order.subtotal) ],
          [ "Tax Rate", number_to_percentage(@order.tax_rate.to_f * 100, precision: 2) ],
          [ "Total", tag.span(format_currency(@order.total), class: "font-semibold") ]
        ] } %>
    <% if @order.notes.present? %>
      <div class="mt-4 pt-4 border-t border-base-300">
        <p class="text-xs font-semibold uppercase tracking-wide text-base-content/70 mb-1">Notes</p>
        <p class="text-sm text-base-content"><%= @order.notes %></p>
      </div>
    <% end %>
  <% end %>
</div>

<%# Line items %>
<% line_items_footer = capture do %>
  <tr class="bg-base-200">
    <td colspan="5" class="text-right font-semibold text-base-content">Total</td>
    <td class="font-semibold text-base-content"><%= format_currency(@order.total) %></td>
  </tr>
<% end if @order.line_items.any? %>

<%= render "shared/card", { title: "Line Items", padded: false } do %>
  <%= render "shared/table", {
        columns: [ "Type", "Description", "Qty", "Unit", "Unit Price", "Total" ],
        footer: line_items_footer
      } do %>
    <% if @order.line_items.any? %>
      <% @order.line_items.each do |line_item| %>
        <tr>
          <td class="text-base-content/70"><%= line_item.item_type.titleize %></td>
          <td class="font-medium text-base-content"><%= line_item.description %></td>
          <td class="text-base-content/70"><%= line_item.quantity %></td>
          <td class="text-base-content/70"><%= line_item.unit %></td>
          <td class="text-base-content/70"><%= format_currency(line_item.unit_price) %></td>
          <td class="font-medium text-base-content"><%= format_currency(line_item.total) %></td>
        </tr>
      <% end %>
    <% else %>
      <%= render partial: "shared/empty_state", locals: { title: "No line items added yet.", colspan: 6 } %>
    <% end %>
  <% end %>
<% end %>
