<% content_for :title, "Edit #{@order.order_number}" %>

<%= render partial: "shared/page_header", locals: {
      title: "Edit #{@order.order_number}",
      breadcrumbs: [
        [ "Jobs", jobs_path ],
        [ @order.job.title, job_path(@order.job) ],
        [ @order.order_number, order_path(@order) ]
      ]
    } %>

<%= render "shared/form_container", { width: :lg } do %>
  <%= render "form", order: @order %>
<% end %>
