<%= form_with model: order,
      url: (order.persisted? ? order_path(order) : job_orders_path(order.job)),
      html: { data: { controller: "order-form" } } do |form| %>

  <%= render partial: "shared/form_errors", locals: { model: order } %>

  <fieldset class="mb-6">
    <legend class="text-sm font-semibold text-base-content uppercase tracking-wide mb-3">Order Details</legend>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <%= render partial: "shared/field", locals: {
            form: form, attr: :status, as: :select,
            collection: Order.statuses.keys.map { |k| [ k.titleize, k ] }
          } %>
      <%= render partial: "shared/field", locals: {
            form: form, attr: :tax_rate, label: "Tax Rate", as: :number,
            options: { step: "0.0001", min: 0 }, hint: "Decimal, e.g. 0.13 for 13%"
          } %>
      <%= render partial: "shared/field", locals: { form: form, attr: :issued_date, label: "Issued Date", as: :date } %>
      <%= render partial: "shared/field", locals: { form: form, attr: :due_date, label: "Due Date", as: :date } %>
      <div class="sm:col-span-2">
        <%= render partial: "shared/field", locals: { form: form, attr: :notes, as: :textarea } %>
      </div>
    </div>
  </fieldset>

  <fieldset class="mb-6">
    <legend class="text-sm font-semibold text-base-content uppercase tracking-wide mb-3">Line Items</legend>

    <div class="hidden sm:grid grid-cols-12 gap-3 px-0 pb-1 text-xs font-semibold text-base-content/70 uppercase tracking-wide">
      <div class="col-span-2">Type</div>
      <div class="col-span-4">Description</div>
      <div class="col-span-1">Qty</div>
      <div class="col-span-1">Unit</div>
      <div class="col-span-2">Unit Price</div>
      <div class="col-span-1">Total</div>
      <div class="col-span-1"></div>
    </div>

    <div data-order-form-target="lineItemsContainer">
      <%= form.fields_for :line_items do |line_item_form| %>
        <%= render "line_item_fields", form: line_item_form %>
      <% end %>
    </div>

    <template data-order-form-target="lineItemTemplate">
      <%= form.fields_for :line_items, LineItem.new, child_index: "NEW_RECORD" do |line_item_form| %>
        <%= render "line_item_fields", form: line_item_form %>
      <% end %>
    </template>

    <button type="button" data-action="click->order-form#addLineItem"
            class="btn btn-ghost btn-sm text-primary mt-3">
      + Add Line Item
    </button>
  </fieldset>

  <%= form.submit class: "btn btn-primary", data: { turbo_submits_with: "Saving…" } %>
<% end %>
