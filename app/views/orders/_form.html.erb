<%= form_with model: order,
      url: (order.persisted? ? order_path(order) : job_orders_path(order.job)),
      html: { data: { controller: "order-form" } } do |form| %>

  <% if order.errors.any? %>
    <div class="mb-6 p-4 bg-red-50 rounded-md">
      <p class="text-sm font-medium text-red-700 mb-1"><%= pluralize(order.errors.count, "error") %> prevented this order from being saved:</p>
      <ul class="list-disc list-inside text-sm text-red-600 space-y-0.5">
        <% order.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <fieldset class="mb-6">
    <legend class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-3">Order Details</legend>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= form.label :status, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.select :status, Order.statuses.keys.map { |k| [k.titleize, k] }, {}, class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500" %>
      </div>
      <div>
        <%= form.label :tax_rate, "Tax Rate (e.g. 0.13 for 13%)", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.number_field :tax_rate, step: "0.0001", min: 0, class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500" %>
      </div>
      <div>
        <%= form.label :issued_date, "Issued Date", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.date_field :issued_date, class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500" %>
      </div>
      <div>
        <%= form.label :due_date, "Due Date", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.date_field :due_date, class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500" %>
      </div>
      <div class="col-span-2">
        <%= form.label :notes, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_area :notes, rows: 3, class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500" %>
      </div>
    </div>
  </fieldset>

  <fieldset class="mb-6">
    <legend class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-3">Line Items</legend>

    <div class="grid grid-cols-12 gap-3 px-0 pb-1 text-xs font-semibold text-gray-400 uppercase tracking-wide">
      <div class="col-span-2">Type</div>
      <div class="col-span-4">Description</div>
      <div class="col-span-1">Qty</div>
      <div class="col-span-1">Unit</div>
      <div class="col-span-2">Unit Price</div>
      <div class="col-span-1">Total</div>
      <div class="col-span-1"></div>
    </div>

    <div data-order-form-target="lineItemsContainer">
      <%= form.fields_for :line_items do |line_item_form| %>
        <%= render "line_item_fields", form: line_item_form %>
      <% end %>
    </div>

    <template data-order-form-target="lineItemTemplate">
      <%= form.fields_for :line_items, LineItem.new, child_index: "NEW_RECORD" do |line_item_form| %>
        <%= render "line_item_fields", form: line_item_form %>
      <% end %>
    </template>

    <button type="button" data-action="click->order-form#addLineItem"
            class="text-sm font-medium text-amber-600 hover:text-amber-500 cursor-pointer mt-3">
      + Add Line Item
    </button>
  </fieldset>

  <%= form.submit class: "rounded-md px-4 py-2.5 bg-amber-600 hover:bg-amber-500 text-white text-sm font-medium cursor-pointer" %>
<% end %>
