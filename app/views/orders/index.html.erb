<% content_for :title, "Orders for #{@job.title}" %>

<%= render partial: "shared/page_header", locals: {
      title: "Orders for #{@job.title}",
      breadcrumbs: [ [ "Jobs", jobs_path ], [ @job.title, job_path(@job) ] ],
      action: { label: "New Order", path: new_job_order_path(@job) }
    } %>

<%= render "shared/table", { columns: [ "Order #", "Status", "Issued", "Total", "" ] } do %>
  <% if @orders.any? %>
    <%= render @orders %>
  <% else %>
    <%= render partial: "shared/empty_state", locals: {
          title: "No orders yet.", colspan: 5,
          cta: { label: "Add the first one", path: new_job_order_path(@job) }
        } %>
  <% end %>
<% end %>
