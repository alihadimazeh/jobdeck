<% content_for :title, "Orders for #{@job.title}" %>
<% content_for :breadcrumbs do %>
  <%= link_to "Jobs", jobs_path %> &rsaquo; <%= link_to @job.title, @job %> &rsaquo; Orders
<% end %>
<% content_for :page_heading, "Orders for #{@job.title}" %>

<div class="flex justify-end mb-6">
  <%= link_to "New Order", new_job_order_path(@job), class: "rounded-md px-3.5 py-2.5 bg-amber-600 hover:bg-amber-500 text-white text-sm font-medium" %>
</div>

<div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Order #</th>
        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Status</th>
        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Issued</th>
        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Total</th>
        <th class="px-6 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% if @orders.any? %>
        <%= render @orders %>
      <% else %>
        <tr>
          <td colspan="5" class="px-6 py-10 text-center text-sm text-gray-400">No orders yet. <%= link_to "Add the first one", new_job_order_path(@job), class: "text-amber-600 hover:underline" %>.</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
