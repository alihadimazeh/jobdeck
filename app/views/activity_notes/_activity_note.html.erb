<%= turbo_frame_tag activity_note, class: "flex items-start justify-between gap-3 py-3 border-b border-base-300 last:border-0" do %>
  <div>
    <p class="text-sm text-base-content whitespace-pre-line"><%= activity_note.body %></p>
    <p class="text-xs text-base-content/70 mt-1">
      <% if activity_note.pinned? %>
        <span class="badge badge-sm badge-warning mr-1">Pinned</span>
      <% end %>
      <%= [ activity_note.author, format_date(activity_note.created_at) ].compact_blank.join(" · ") %>
    </p>
  </div>
  <%= render partial: "shared/row_actions", locals: {
        edit_path: edit_activity_note_path(activity_note),
        delete_path: activity_note_path(activity_note),
        delete_confirm: "Are you sure you want to delete this note?",
        label: activity_note.body.truncate(30),
        id: dom_id(activity_note),
        turbo_frame: "_top"
      } %>
<% end %>
